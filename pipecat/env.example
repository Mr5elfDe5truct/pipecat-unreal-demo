# Speech to text, and the voice unless Cartesia has a key.
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-draco-en

# The LLM: OpenAI if it has a key, else Gemini if it has one, else a local Ollama model.
