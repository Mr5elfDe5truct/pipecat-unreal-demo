# Unreal Engine build output and caches.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Copied from the engine by setup.sh or setup.ps1, except the splash screens.
/Content/*
!/Content/Splash/

# Built by Plugins/Pipecat/ThirdParty/build-linux.sh, build-mac.sh or
# build-windows.ps1.
Plugins/Pipecat/ThirdParty/build/
Plugins/Pipecat/ThirdParty/Linux/
Plugins/Pipecat/ThirdParty/Mac/
Plugins/Pipecat/ThirdParty/Win64/

# Editor project files.
*.code-workspace
.vscode/
.idea/

# The bot's virtual environment and secrets.
pipecat/.venv/
pipecat/.env
pipecat/.envrc
pipecat/__pycache__/
